# BAZE API Gateway 연결 정보
BAZE_BASE_URL=
BAZE_API_KEY=
BAZE_MODEL=
BAZE_CHAT_PATH=
BAZE_TIMEOUT_SECONDS=

# 비워 두면 mock 모드. 실제 호출은 baze로 설정
AI_MODE=
AI_SYSTEM_PROMPT=
CORS_ORIGINS=

# 녹음형 상담 비교 프리셋 (비워 두면 코드 기본값 사용)
BAZE_QUALITY_MODEL=
BAZE_ECONOMY_MODEL=
BAZE_STT_MODEL=
BAZE_TTS_MODEL=
BAZE_TTS_VOICE=

# 교사 보고함 접속키. 미설정 시 일반 서버 시작 과정에서 자동 생성해 .env에만 저장
TEACHER_ACCESS_TOKEN=
# backend 안의 상대 경로. 비우면 data/safepath.sqlite3
COUNSEL_DATABASE_PATH=

# 배포 프론트 계약용 가상 데이터 API. 사용 시 true, 실제 상담 API와 분리
FRONTEND_DEMO_ENABLED=
# 외부 배포 시 허용할 백엔드 호스트 이름. 기본은 localhost·127.0.0.1
ALLOWED_HOSTS=

# 프론트 상담: mock 또는 baze. 실제 호출은 고성능 모델 하나만 사용
FRONTEND_AI_MODE=
# 외부 배포에서 실제 호출을 보호할 서버 연동키. VITE_*에 넣지 않음
FRONTEND_ACCESS_TOKEN=

# 공유 서버 전용. start_shared.cmd는 .env.shared에 별도 키와 주소를 생성
SHARED_SERVER_MODE=
PUBLIC_BASE_URL=
